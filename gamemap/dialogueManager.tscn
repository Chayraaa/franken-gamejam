[node name="Task1" type="Node2D" parent="DialogueRoot" unique_id=530026809]
script = ExtResource("2_3bxp4")
task_text = "Wir haben einige verdächtige Aktivitäten mitbekommen, die das Kraftwerk beeinflussen. Achten sie auf verdächtige Anfragen. Achten sie darauf, nicht diesen Anfragen nachzugehen. Sie können diese oft an merkwürdigen Inhalten oder komischen Formulierungen erkennen. Unser Team sitzt bereits an der Behebung des Zwischenfalls."

