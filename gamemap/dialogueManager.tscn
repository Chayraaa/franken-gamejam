[node name="Task11" type="Node2D" parent="DialogueRoot" unique_id=201352069]
position = Vector2(3, 0)
script = ExtResource("2_3bxp4")
task_text = "Guten Tag. Wir sind hier auf ein Problem gestoßen, das unmittelbar behoben werden muss. Einer unserer Mitarbeiter hat eine Ladung Brennstäbe an den falschen Ort gebracht, wodurch die Gefahr besteht, dass sich der Vorfall von vor 5 Jahren wiederholt. Wir bitten Sie erneut, dringlichst diesen Fehler zu beheben. Sie erhalten dafür selbstverständlich eine Bonuszahlung auf ihr nächstes Gehalt. Bitte entschuldigen Sie die Unannehmlichkeiten."
level_number = 11

