[node name="Task5" type="Node2D" parent="DialogueRoot" unique_id=2137053729]
script = ExtResource("2_3bxp4")
task_text = "bei uns gibt es ein kleines problem. die kühlwasserversorgung ist unterbrochen. das ist kein großes problem aber sollte trotzdem behoben werden. alles was du tun musst ist die versorgung abzustellen damit wir daran arbeiten können. wir werden die versorgung dann selbst wieder aktivieren. danke für deine hilfe."
level_number = 5

