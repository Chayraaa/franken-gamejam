[node name="Task4" type="Node2D" parent="DialogueRoot" unique_id=1282863584]
script = ExtResource("2_3bxp4")
task_text = "Wir haben hier ein klitzekleines Problemchen. Dank Remoh ist die neue Lieferung von Brennstäben am falschen Ort gelandet. Ich frage mich schon lange, wann sie ihn endlich Feuern werden. Wegen ihm fand die Katastrophe vor 5 Jahren statt. Sowas können wir uns nicht noch einmal erlauben, also bring das in Ordnung."
level_number = 4

