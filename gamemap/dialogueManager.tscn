[node name="Task9" type="Node2D" parent="DialogueRoot" unique_id=625207015]
position = Vector2(3, 0)
script = ExtResource("2_3bxp4")
task_text = "BEI UNS GIBT ES EIN DRINGLICHES PROBLEM. DIE KÜHLWASSERVERSORGUNG IST UNTERBROCHEN WODURCH UNS BALD ALLES IN DIE LUFT FLIEGT. ICH WILL NICHT, DASS NOCH EIN KRAFTWERK IN DIE LUFT FLIEGT! ICH WILL MEINE FRAU UND KINDER WIEDER SEHEN! KÜMMER DICH SCHNELL DARUM, DAMIT WIR ALLE WEITERLEBEN!"
